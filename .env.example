# Copy this file to .env and paste your Google AI Studio key.
# Never commit .env.
GEMINI_API_KEY=

# Optional. Model used for image extraction (default: gemini-2.5-flash).
# Free-tier quota is per model, so switching here is the quickest way off an
# exhausted one, e.g. GEMINI_MODEL=gemini-2.5-flash-lite
# GEMINI_MODEL=
